# Copy to signing/local.env (git-ignored) and fill in your own values.
# scripts/bundle.sh reads it on every build; variables already set in the environment win.

# Your Apple team ID (developer.apple.com/account › Membership details). Leave it out to use
# the team of the one Apple Development certificate in your login keychain.
#KIVUKO_TEAM=ABCDE12345

# A reverse-DNS prefix you control. The app becomes <prefix>.kivuko and the tunnel
# <prefix>.kivuko.tunnel. Bundle IDs are unique across all Apple developer accounts, so the
# default (top.piedol, the project's own) won't sign for anyone else.
KIVUKO_BUNDLE_PREFIX=com.example
